# Optional: GitHub personal access token. For public repositories, a token is not required.
GITHUB_TOKEN=

# One or more public repositories, separated by commas.
GITHUB_REPOSITORIES=pallets/flask,streamlit/streamlit

# Hugging Face model used for 3-class sentiment classification.
SENTIMENT_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment

# SQLite database path.
DATABASE_PATH=data/messages.db
